<Window
    x:Class="HajimiWinApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HajimiWinApp.Controls"
    Title="Hajimi · 原生网络引擎">

    <Grid x:Name="RootGrid" Background="{StaticResource HajimiWorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Immersive Unified TitleBar (macOS Window Chrome Parity) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource HajimiSidebarBrush}"
                    BorderBrush="{StaticResource HajimiBorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Padding="18,0,0,0">
                    <Ellipse Width="9" Height="9" Fill="#2ED19C" />
                    <TextBlock Text="HAJIMI DESKTOP" FontSize="10.5" FontWeight="Bold" CharacterSpacing="90"
                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource HajimiWorkspaceBrush}"
                    BorderBrush="{StaticResource HajimiBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Padding="24,0,160,0">
                    <TextBlock x:Name="TitleBarStatusText"
                               Text="Unified C11/C++17 Core · HTTP 127.0.0.1:7890 · SOCKS5 127.0.0.1:7891"
                               FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Body: Left Sidebar (244px) + Right Bento Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Unified macOS-Style Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource HajimiSidebarBrush}"
                    BorderBrush="{StaticResource HajimiBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14,12,14,14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Emblem + Live Status Pill -->
                    <Grid Grid.Row="0" Padding="4,2,4,4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                                Background="{StaticResource HajimiAccentSoftBrush}"
                                BorderBrush="{StaticResource HajimiAccentBorderBrush}"
                                BorderThickness="1">
                            <FontIcon Glyph="&#xE774;" FontSize="17"
                                      Foreground="{StaticResource HajimiAccentTextBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Hajimi" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                        CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarRunBadgeText" Text="运行中" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource HajimiAccentTextBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="EngineVersionLabel" Text="Core 0.2.2" FontSize="11"
                                       Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- macOS-Style 3-Segment Outbound Mode Pill Switcher -->
                    <Border Grid.Row="1"
                            Background="{StaticResource HajimiMutedPanelBrush}"
                            BorderBrush="{StaticResource HajimiBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="3">
                        <Grid ColumnSpacing="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ModeRuleBtn" Grid.Column="0" Content="规则"
                                    HorizontalAlignment="Stretch" Padding="0,6" CornerRadius="7"
                                    BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                    Click="OnModeRuleClick" />
                            <Button x:Name="ModeGlobalBtn" Grid.Column="1" Content="全局"
                                    HorizontalAlignment="Stretch" Padding="0,6" CornerRadius="7"
                                    BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                    Click="OnModeGlobalClick" />
                            <Button x:Name="ModeDirectBtn" Grid.Column="2" Content="直连"
                                    HorizontalAlignment="Stretch" Padding="0,6" CornerRadius="7"
                                    BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                    Click="OnModeDirectClick" />
                        </Grid>
                    </Border>

                    <!-- 8 Iconified Navigation Items (Matching macOS MainWindowController) -->
                    <ListView x:Name="NavList"
                              Grid.Row="2"
                              SelectionMode="Single"
                              SelectionChanged="OnNavSelectionChanged">
                        <ListViewItem Tag="Overview" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE80F;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="网络总览" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Policies" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE701;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="策略与节点" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Connections" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8CE;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="活动连接" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Rules" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="分流规则" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Subscriptions" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE895;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="订阅与规则集" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Dns" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE774;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="DNS 设置" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Diagnostics" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE9D9;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="网络诊断" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Themes" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE790;" FontSize="14.5" Foreground="{StaticResource HajimiAccentTextBrush}" />
                                <TextBlock Text="外观主题" FontSize="13" FontWeight="Medium" Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>

                    <!-- Bottom System Takeover Card -->
                    <Border Grid.Row="3"
                            Background="{StaticResource HajimiPanelBrush}"
                            BorderBrush="{StaticResource HajimiBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource HajimiInnerCornerRadius}"
                            Padding="12,10">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="系统代理" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <TextBlock Text="WinINet 浏览器接管" FontSize="10.5"
                                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SysProxyToggle" Grid.Column="1"
                                              OnContent="" OffContent="" MinWidth="0"
                                              Toggled="OnSysProxyToggled" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource HajimiBorderBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TUN 增强模式" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <TextBlock Text="Wintun 全局虚拟网卡" FontSize="10.5"
                                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EnhancedTunToggle" Grid.Column="1"
                                              OnContent="" OffContent="" MinWidth="0"
                                              Toggled="OnEnhancedTunToggled" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource HajimiBorderBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="CloseToTrayCheck" Content="驻留托盘" IsChecked="True"
                                          FontSize="11" MinWidth="0" Padding="4,0,0,0"
                                          Foreground="{StaticResource HajimiTextSecondaryBrush}"
                                          Click="OnCloseToTrayCheckClicked" />
                                <CheckBox x:Name="AutoStartCheck" Content="开机自启"
                                          FontSize="11" MinWidth="0" Padding="4,0,0,0"
                                          Foreground="{StaticResource HajimiTextSecondaryBrush}"
                                          Click="OnAutoStartCheckClicked" />
                            </StackPanel>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="最小化托盘" HorizontalAlignment="Stretch"
                                        Style="{StaticResource HajimiSecondaryButtonStyle}"
                                        Padding="6,5" FontSize="11.5"
                                        Click="OnHideToTrayClick" />
                                <Button Grid.Column="1" Content="彻底退出" HorizontalAlignment="Stretch"
                                        Style="{StaticResource HajimiSecondaryButtonStyle}"
                                        Padding="6,5" FontSize="11.5"
                                        Click="OnExplicitExitClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Workspace Container -->
            <Grid Grid.Column="1" Padding="26,18,26,22" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="StatusBanner" Grid.Row="0" IsOpen="False" IsClosable="True" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- =========================================================
                             1. OVERVIEW (CONTROL CENTER)
                             ========================================================= -->
                        <StackPanel x:Name="SectionOverview" Spacing="16">
                            <!-- macOS Eyebrow + Header + Quick Actions -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                            CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="CONTROL CENTER" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="网络与流量总览" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <TextBlock x:Name="OverviewProfileSummaryText"
                                               Text="正在读取当前生效配置状态..."
                                               FontSize="12.5"
                                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="导入配置文件" Style="{StaticResource HajimiPrimaryButtonStyle}"
                                            Click="OnImportProfileFileClick" />
                                    <Button Content="复制终端代理" Style="{StaticResource HajimiSecondaryButtonStyle}"
                                            Click="OnCopyPwshClick" />
                                    <Button Content="刷新 DNS 缓存" Style="{StaticResource HajimiSecondaryButtonStyle}"
                                            Click="OnFlushDnsClick" />
                                </StackPanel>
                            </Grid>

                            <!-- 4 Bento Telemetry KPI Cards -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource HajimiPanelBrush}"
                                        BorderBrush="{StaticResource HajimiBorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource HajimiCardCornerRadius}" Padding="16,14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource HajimiAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="实时下行速率" FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="DownSpeedText" Text="0 B/s" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                        <TextBlock x:Name="TotalDownText" Text="累计下行 0 B" FontSize="11"
                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{StaticResource HajimiPanelBrush}"
                                        BorderBrush="{StaticResource HajimiBorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource HajimiCardCornerRadius}" Padding="16,14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource HajimiUploadAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="实时上行速率" FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="UpSpeedText" Text="0 B/s" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource HajimiUploadAccentBrush}" />
                                        <TextBlock x:Name="TotalUpText" Text="累计上行 0 B" FontSize="11"
                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource HajimiPanelBrush}"
                                        BorderBrush="{StaticResource HajimiBorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource HajimiCardCornerRadius}" Padding="16,14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource HajimiIndigoAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="活动并发会话" FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="ActiveConnText" Text="0" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <TextBlock x:Name="TotalConnSubText" Text="TCP / UDP 实时多路复用" FontSize="11"
                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="{StaticResource HajimiPanelBrush}"
                                        BorderBrush="{StaticResource HajimiBorderBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource HajimiCardCornerRadius}" Padding="16,14">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" />
                                            <TextBlock Text="Fake-IP / DNS 命中" FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="DnsHitText" Text="0 / 0" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <TextBlock Text="198.19.0.0/16 零污染映射" FontSize="11"
                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Dual-Series Waveform Card + 4-Column Runtime Endpoint Strip -->
                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="18,16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="60 秒双序列吞吐波形（下行 / 上行）"
                                                   FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource HajimiAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="下行 Download" FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource HajimiUploadAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="上行 Upload" FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <controls:TrafficWaveformCanvas x:Name="WaveformChart" Height="208" />

                                    <Border Background="{StaticResource HajimiMutedPanelBrush}"
                                            BorderBrush="{StaticResource HajimiBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource HajimiInnerCornerRadius}"
                                            Padding="14,10">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="HTTP / HTTPS 入站" FontSize="10.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                <TextBlock x:Name="OverviewHttpEndpointText" Text="127.0.0.1:7890" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="SOCKS5 + UDP 入站" FontSize="10.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                <TextBlock x:Name="OverviewSocksEndpointText" Text="127.0.0.1:7891" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="当前路由接管模式" FontSize="10.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                <TextBlock x:Name="OverviewActiveModeText" Text="规则分流 (Rule)" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HajimiAccentTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBlock Text="统一数据面架构" FontSize="10.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                <TextBlock Text="64-Pkt SPSC + SlabPool" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- =========================================================
                             2. POLICIES & NODE PILL MATRIX (macOS PolicyUIComponents Parity)
                             ========================================================= -->
                        <StackPanel x:Name="SectionPolicies" Visibility="Collapsed" Spacing="16">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                            CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="POLICIES &amp; NODES" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="策略组与节点矩阵" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <TextBlock x:Name="PolicySummaryText" Text="正在读取策略组与节点..." FontSize="12.5"
                                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox x:Name="NodeSearchBox" Width="210"
                                             PlaceholderText="搜索节点名 / 地区 / 协议..."
                                             TextChanged="OnNodeSearchTextChanged" />
                                    <Button x:Name="ProbeAllBtn" Content="⚡ 并发测速全部节点"
                                            Style="{StaticResource HajimiPrimaryButtonStyle}"
                                            Click="OnProbeAllNodesClick" />
                                </StackPanel>
                            </Grid>

                            <!-- Policy Group Bento Cards Container (3-Column Clickable Node Pill Matrix) -->
                            <StackPanel x:Name="PolicyGroupsPanel" Spacing="14" />

                            <!-- All Nodes Inventory Card -->
                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="全部代理节点明细（支持全协议单独握手测速）"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <TextBlock x:Name="FilteredNodeCountText" Grid.Column="1"
                                                   Text="0 个节点" FontSize="12"
                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                    </Grid>

                                    <ListView x:Name="NodesListView" MaxHeight="340" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HajimiElevatedPanelBrush}"
                                                        BorderBrush="{StaticResource HajimiBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="12,8"
                                                        Margin="0,3">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="230" />
                                                            <ColumnDefinition Width="125" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <Border Grid.Column="1" Background="{StaticResource HajimiAccentSoftBrush}"
                                                                CornerRadius="5" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TypeBadge}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding EndpointText}" FontSize="12"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding LatencyText}" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                        <Button Grid.Column="4" Content="测速" Tag="{Binding Name}"
                                                                Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                                Padding="10,4" FontSize="11.5"
                                                                Click="OnProbeSingleNodeClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- =========================================================
                             3. ACTIVE CONNECTIONS & STREAMING LOGS
                             ========================================================= -->
                        <StackPanel x:Name="SectionConnections" Visibility="Collapsed" Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                            CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="CONNECTIONS &amp; LOGS" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="实时连接与内核日志" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="ConnFilterBox" Grid.Column="1" VerticalAlignment="Center"
                                         PlaceholderText="按进程 / 域名 / 策略筛选..."
                                         TextChanged="OnConnFilterTextChanged" />
                                <Button Grid.Column="2" Content="一键断开全部" VerticalAlignment="Center"
                                        Style="{StaticResource HajimiSecondaryButtonStyle}"
                                        Click="OnCloseAllConnectionsClick" />
                            </Grid>

                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <Grid Padding="10,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="客户端进程" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="目标地址 (Host:Port)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="协议" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="命中出站策略" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="实时流量" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        <TextBlock Grid.Column="5" Text="操作" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                    </Grid>

                                    <ListView x:Name="ConnectionsListView" Height="270" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HajimiElevatedPanelBrush}"
                                                        CornerRadius="8" Padding="10,7" Margin="0,2">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="85" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="155" />
                                                            <ColumnDefinition Width="64" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ProcessLabel}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding EndpointText}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Proto}" FontSize="11.5"
                                                                   VerticalAlignment="Center" Foreground="{StaticResource HajimiUploadAccentBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Policy}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding TrafficText}" FontSize="11.5"
                                                                   VerticalAlignment="Center" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                        <Button Grid.Column="5" Content="断开" Tag="{Binding Id}"
                                                                Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                                Padding="8,3" FontSize="11"
                                                                Click="OnKillSingleConnClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="16">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="内核实时流式日志" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <Button Grid.Column="1" Content="清空日志" Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                Padding="10,4" FontSize="11.5" Click="OnClearLogViewClick" />
                                    </Grid>
                                    <TextBox x:Name="RuntimeLogsBox" IsReadOnly="True" AcceptsReturn="True"
                                             TextWrapping="Wrap" Height="175" FontFamily="Consolas" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- =========================================================
                             4. RULES (VISUAL PARSED RULES TABLE + RAW SOURCE EDITOR)
                             ========================================================= -->
                        <StackPanel x:Name="SectionRules" Visibility="Collapsed" Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                            CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="ROUTING RULES" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="分流规则与配置编辑器" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <TextBlock x:Name="EditorStatsLabel"
                                               Text="支持 Surge .conf / Clash (Mihomo) .yaml / 多行 Base64 订阅全兼容解析"
                                               FontSize="12.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Visual Table vs Raw Editor Segmented Switch -->
                                    <Border Background="{StaticResource HajimiMutedPanelBrush}"
                                            BorderBrush="{StaticResource HajimiBorderBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="3">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="RulesTabVisualBtn" Content="可视化规则表"
                                                    Padding="12,5" CornerRadius="6" BorderThickness="0" FontSize="12"
                                                    Click="OnRulesTabVisualClick" />
                                            <Button x:Name="RulesTabRawBtn" Content="原始配置源码"
                                                    Padding="12,5" CornerRadius="6" BorderThickness="0" FontSize="12"
                                                    Click="OnRulesTabRawClick" />
                                        </StackPanel>
                                    </Border>
                                    <Button Content="导入本地配置..." Style="{StaticResource HajimiSecondaryButtonStyle}"
                                            Click="OnImportProfileFileClick" />
                                    <Button Content="保存并热重载" Style="{StaticResource HajimiPrimaryButtonStyle}"
                                            Click="OnApplyProfileEditorClick" />
                                </StackPanel>
                            </Grid>

                            <!-- Visual Rules Table Mode -->
                            <StackPanel x:Name="RulesVisualContainer" Spacing="14">
                                <!-- Live Route Match Simulator -->
                                <Border Background="{StaticResource HajimiPanelBrush}"
                                        BorderBrush="{StaticResource HajimiBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                        Padding="16,12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="分流命中测试" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <TextBox x:Name="RouteTestHostBox" Grid.Column="1"
                                                 PlaceholderText="输入目标域名或 IP（如 chatgpt.com、youtube.com、223.5.5.5）实时验证路由..." />
                                        <Button Grid.Column="2" Content="测试匹配" Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                Click="OnTestRouteMatchClick" />
                                        <Border Grid.Column="3" Background="{StaticResource HajimiAccentSoftBrush}"
                                                CornerRadius="7" Padding="10,6" VerticalAlignment="Center">
                                            <TextBlock x:Name="RouteTestResultText" Text="等待输入测试目标" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HajimiAccentTextBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Searchable Parsed Rules Table -->
                                <Border Background="{StaticResource HajimiPanelBrush}"
                                        BorderBrush="{StaticResource HajimiBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                        Padding="16">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RuleSearchBox"
                                                     PlaceholderText="搜索规则类型 (RULE-SET / DOMAIN-SUFFIX / GEOSITE) / 域名 / 策略组..."
                                                     TextChanged="OnRuleSearchTextChanged" />
                                            <Border Grid.Column="1" Background="{StaticResource HajimiElevatedPanelBrush}"
                                                    BorderBrush="{StaticResource HajimiBorderBrush}" BorderThickness="1"
                                                    CornerRadius="7" Padding="12,6" VerticalAlignment="Center">
                                                <TextBlock x:Name="FinalPolicyBadgeText" Text="兜底策略 FINAL → DIRECT"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HajimiAccentTextBrush}" />
                                            </Border>
                                        </Grid>

                                        <ListView x:Name="ParsedRulesListView" Height="420" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource HajimiElevatedPanelBrush}"
                                                            CornerRadius="8" Padding="12,8" Margin="0,2">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="145" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="180" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding IndexText}" FontSize="11.5"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                            <Border Grid.Column="1" Background="{StaticResource HajimiAccentSoftBrush}"
                                                                    CornerRadius="5" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding PatternDisplay}" FontFamily="Consolas" FontSize="12.5"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Policy}" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource HajimiUploadAccentBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Raw Source Editor Mode -->
                            <Border x:Name="RulesRawContainer" Visibility="Collapsed"
                                    Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="14">
                                <TextBox x:Name="ProfileEditorBox"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Height="500"
                                         FontFamily="Consolas"
                                         FontSize="12.5"
                                         PlaceholderText="# 粘贴或导入 Surge (.conf) / Clash / Mihomo (.yaml) / Base64 节点订阅..." />
                            </Border>
                        </StackPanel>

                        <!-- =========================================================
                             5. SUBSCRIPTIONS, NODE PROVIDERS & RULE-SETS
                             ========================================================= -->
                        <StackPanel x:Name="SectionSubscriptions" Visibility="Collapsed" Spacing="16">
                            <StackPanel Spacing="4">
                                <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                        CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="SUBSCRIPTIONS &amp; PROVIDERS" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                               Foreground="{StaticResource HajimiAccentTextBrush}" />
                                </Border>
                                <TextBlock Text="远程订阅与规则集管理" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                <TextBlock Text="支持机场订阅、Clash proxy-providers / policy-path 外部节点源以及 .mrs/.yaml/.list 规则集自动加速同步"
                                           FontSize="12.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                            </StackPanel>

                            <!-- 1. Remote Subscription Management Card (Add / Switch / Update / Delete) -->
                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="18,16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="远程订阅管理（支持多机场订阅切换、单独更新与删除）"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            <TextBlock x:Name="SubSyncStatusLabel"
                                                       Text="支持 Clash / Mihomo YAML、Surge .conf 与多行折行 Base64 订阅"
                                                       FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="↻ 全部更新"
                                                Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                Click="OnUpdateAllSubscriptionsClick" />
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SubNameInput" Grid.Column="0"
                                                 PlaceholderText="订阅名称（可选）" />
                                        <TextBox x:Name="SubUrlInput" Grid.Column="1"
                                                 PlaceholderText="https://example.com/api/v1/client/subscribe?token=..." />
                                        <Button Grid.Column="2" Content="添加并拉取"
                                                Style="{StaticResource HajimiPrimaryButtonStyle}"
                                                Click="OnFetchSubscriptionClick" />
                                    </Grid>

                                    <TextBlock x:Name="RemoteSubsEmptyText"
                                               Text="暂无已保存的远程订阅，在上方输入链接点击「添加并拉取」即可纳入管理"
                                               FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />

                                    <ListView x:Name="RemoteSubsListView" MaxHeight="220" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HajimiElevatedPanelBrush}"
                                                        BorderBrush="{StaticResource HajimiBorderBrush}"
                                                        BorderThickness="1" CornerRadius="9"
                                                        Padding="12,9" Margin="0,3">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource HajimiAccentSoftBrush}"
                                                                CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ActiveBadge}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding MetaSummary}" FontSize="11.5"
                                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Source}" FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="启用" Tag="{Binding Id}"
                                                                    Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                                    Padding="10,4" FontSize="11.5"
                                                                    Click="OnActivateManagedProfileClick" />
                                                            <Button Content="更新" Tag="{Binding Id}"
                                                                    Style="{StaticResource HajimiPrimaryButtonStyle}"
                                                                    Padding="10,4" FontSize="11.5"
                                                                    Click="OnUpdateSingleSubscriptionClick" />
                                                            <Button Content="删除" Tag="{Binding Id}"
                                                                    Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                                    Padding="10,4" FontSize="11.5"
                                                                    Click="OnDeleteManagedProfileClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- 2. Local Imported Profile Files Management Card (Import / Switch / Delete) -->
                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="18,16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="本地导入配置管理（支持导入 Surge .conf / Clash .yaml 切换与删除）"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            <TextBlock x:Name="LocalProfilesEmptyText"
                                                       Text="尚未导入本地配置文件，点击右侧按钮可导入并托管多个本地档案"
                                                       FontSize="11.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="导入本地文件..."
                                                Style="{StaticResource HajimiPrimaryButtonStyle}"
                                                Click="OnImportProfileFileClick" />
                                    </Grid>

                                    <ListView x:Name="LocalProfilesListView" MaxHeight="200" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HajimiElevatedPanelBrush}"
                                                        BorderBrush="{StaticResource HajimiBorderBrush}"
                                                        BorderThickness="1" CornerRadius="9"
                                                        Padding="12,9" Margin="0,3">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{StaticResource HajimiAccentSoftBrush}"
                                                                CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ActiveBadge}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding MetaSummary}" FontSize="11.5"
                                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Source}" FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="启用" Tag="{Binding Id}"
                                                                    Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                                    Padding="10,4" FontSize="11.5"
                                                                    Click="OnActivateManagedProfileClick" />
                                                            <Button Content="删除" Tag="{Binding Id}"
                                                                    Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                                    Padding="10,4" FontSize="11.5"
                                                                    Click="OnDeleteManagedProfileClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- External Proxy-Providers Card (Shown when profile defines proxy-providers / policy-path) -->
                            <Border x:Name="NodeProvidersCard" Visibility="Collapsed"
                                    Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="18,16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="NodeProvidersSummaryText"
                                               Text="外部节点提供者 (proxy-providers / policy-path)"
                                               FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <ListView x:Name="NodeProvidersListView" MaxHeight="180" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HajimiElevatedPanelBrush}"
                                                        CornerRadius="8" Padding="12,8" Margin="0,2">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="140" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Url}" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <!-- External Rule-Sets Card -->
                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="18,16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="外部规则集 (RULE-SET / DOMAIN-SET / GEOSITE / GEOIP)"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            <TextBlock x:Name="RuleSetsSummaryText" Text="当前配置未引用外部规则集"
                                                       FontSize="12" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="同步全部规则集"
                                                Style="{StaticResource HajimiPrimaryButtonStyle}"
                                                Click="OnRefreshRuleSetsClick" />
                                    </Grid>

                                    <ListView x:Name="RuleSetsListView" MaxHeight="340" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource HajimiElevatedPanelBrush}"
                                                        CornerRadius="8" Padding="12,8" Margin="0,2">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="165" />
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="135" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="105" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <Border Grid.Column="1" Background="{StaticResource HajimiAccentSoftBrush}"
                                                                CornerRadius="5" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BehaviorBadge}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Policy}" FontSize="12" FontWeight="Medium"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiUploadAccentBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding UrlDisplay}" FontSize="11.5"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- =========================================================
                             6. DNS SETTINGS & WFP ANTI-LEAK
                             ========================================================= -->
                        <StackPanel x:Name="SectionDns" Visibility="Collapsed" Spacing="16">
                            <StackPanel Spacing="4">
                                <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                        CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="ENCRYPTED DNS &amp; FAKE-IP" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                               Foreground="{StaticResource HajimiAccentTextBrush}" />
                                </Border>
                                <TextBlock Text="DNS 解析与防泄漏设置" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                <TextBlock Text="管理当前生效配置的加密 DoH / DoT 上游、传统 Bootstrap DNS 与 Fake-IP 地址池"
                                           FontSize="12.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                            </StackPanel>

                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="20,18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="启用 Fake-IP 极速映射 (198.19.0.0/16)" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            <TextBlock Text="零等待返回虚拟 IPv4 并在出站连接时无损还原真实域名，彻底消除本地 DNS 抢答污染"
                                                       FontSize="12" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DnsFakeIpSwitch" Grid.Column="1" IsOn="True" OnContent="开启" OffContent="关闭" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource HajimiBorderBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="启用 IPv6 AAAA 解析响应" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                            <TextBlock Text="若当前节点仅支持 IPv4，建议保持关闭以避免双栈降级延迟"
                                                       FontSize="12" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DnsIpv6Switch" Grid.Column="1" IsOn="False" OnContent="开启" OffContent="关闭" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource HajimiBorderBrush}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="加密 DNS 上游 (DoH / DoT，多个地址以英文逗号分隔)"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <TextBox x:Name="DnsEncryptedBox"
                                                 Text="https://1.1.1.1/dns-query, tls://1.1.1.1:853" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="传统 Bootstrap DNS 服务器 (用于解析代理节点与 DoH 域名)"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                        <TextBox x:Name="DnsBootstrapBox"
                                                 Text="223.5.5.5, 119.29.29.29, 1.1.1.1" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="应用 DNS 配置到当前档案"
                                                Style="{StaticResource HajimiPrimaryButtonStyle}"
                                                Click="OnSaveDnsConfigClick" />
                                        <Button Content="立即清空 DNS 与 Fake-IP 缓存"
                                                Style="{StaticResource HajimiSecondaryButtonStyle}"
                                                Click="OnFlushDnsClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="18,14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Windows WFP 内核级防 DNS 泄漏保护" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource HajimiAccentTextBrush}" />
                                    <TextBlock Text="开启「TUN 增强模式」后，HajimiHelperService 自动注入动态会话级 WFP 过滤规则（DYNAMIC session — 进程异常退出由内核零残留自动回收），强制阻断非虚拟网卡接口上的明文 53 端口旁路查询，彻底免疫 Windows 10/11 Smart Multi-Homed Name Resolution (SMHNR) 泄漏。"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- =========================================================
                             7. 5-STAGE WATERFALL DIAGNOSTICS
                             ========================================================= -->
                        <StackPanel x:Name="SectionDiagnostics" Visibility="Collapsed" Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                            CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="DIAGNOSTICS" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="五阶段网络瀑布流自检" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <TextBlock Text="逐级验证本地回环、物理出口绑定、加密 DNS 缓存、密码学协议栈与代理监听端口"
                                               FontSize="12.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="运行全链路自检" VerticalAlignment="Center"
                                        Style="{StaticResource HajimiPrimaryButtonStyle}"
                                        Click="OnRunDiagnosticsClick" />
                            </Grid>

                            <StackPanel x:Name="DiagnosticsCardsPanel" Spacing="10" />

                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="14">
                                <TextBox x:Name="DiagnosticsOutputBox" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="150" FontFamily="Consolas" FontSize="12"
                                         PlaceholderText="点击右上角「运行全链路自检」生成五阶段健康报告..." />
                            </Border>
                        </StackPanel>

                        <!-- =========================================================
                             8. 50-THEME VISUAL SWATCH GALLERY (APPEARANCE)
                             ========================================================= -->
                        <StackPanel x:Name="SectionThemes" Visibility="Collapsed" Spacing="16">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <Border Background="{StaticResource HajimiAccentSoftBrush}"
                                            CornerRadius="5" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="APPEARANCE &amp; THEMES" FontSize="10" FontWeight="Bold" CharacterSpacing="80"
                                                   Foreground="{StaticResource HajimiAccentTextBrush}" />
                                    </Border>
                                    <TextBlock Text="双端统一外观主题画廊" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                    <TextBlock x:Name="ActiveThemeStatusText"
                                               Text="内置 50 款与 macOS 100% 同源的色彩令牌主题，点击任意卡片零闪烁即时切换"
                                               FontSize="12.5" Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="ThemeSearchBox" Grid.Column="1" VerticalAlignment="Center"
                                         PlaceholderText="搜索主题名称 / 分类 / 编号..."
                                         TextChanged="OnThemeSearchTextChanged" />
                            </Grid>

                            <Border Background="{StaticResource HajimiPanelBrush}"
                                    BorderBrush="{StaticResource HajimiBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource HajimiCardCornerRadius}"
                                    Padding="16,12">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ThemeUrlBox"
                                             PlaceholderText="通过 HTTPS 导入远程 .hajimitheme.json 主题包..." />
                                    <Button Grid.Column="1" Content="HTTPS 导入"
                                            Style="{StaticResource HajimiPrimaryButtonStyle}"
                                            Click="OnImportRemoteThemeClick" />
                                    <Button Grid.Column="2" Content="导入本地文件..."
                                            Style="{StaticResource HajimiSecondaryButtonStyle}"
                                            Click="OnImportLocalThemeFileClick" />
                                </Grid>
                            </Border>

                            <ListView x:Name="ThemeGalleryList"
                                      Height="470"
                                      SelectionMode="Single"
                                      SelectionChanged="OnThemeSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource HajimiPanelBrush}"
                                                BorderBrush="{StaticResource HajimiBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="16,12"
                                                Margin="0,4">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{StaticResource HajimiAccentSoftBrush}"
                                                        CornerRadius="8" Padding="6,6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{StaticResource HajimiAccentTextBrush}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource HajimiTextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding EnglishName}" FontSize="11.5" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LayoutStyle}" FontSize="11.5"
                                                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{StaticResource HajimiElevatedPanelBrush}"
                                                        CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="11.5"
                                                               Foreground="{StaticResource HajimiTextSecondaryBrush}" />
                                                </Border>

                                                <!-- 5 Live Color Palette Swatch Dots -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="18" Height="18" Fill="{Binding SwatchWorkspace}" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Ellipse Width="18" Height="18" Fill="{Binding SwatchSidebar}" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Ellipse Width="18" Height="18" Fill="{Binding SwatchPanel}" Stroke="#44FFFFFF" StrokeThickness="1" />
                                                    <Ellipse Width="18" Height="18" Fill="{Binding SwatchAccent}" Stroke="#66FFFFFF" StrokeThickness="1" />
                                                    <Ellipse Width="18" Height="18" Fill="{Binding SwatchUpload}" Stroke="#66FFFFFF" StrokeThickness="1" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
